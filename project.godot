; Special Ops — Level 1 prototype
; Godot 4.x

[application]
config/name="Special Ops"
run/main_scene="res://scenes/level_1.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
crouch={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67)]}
shoot={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
reload={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
